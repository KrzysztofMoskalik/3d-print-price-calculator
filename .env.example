# Set to true to enable the account/registration area.
AUTH_ENABLED=false
JWT_SECRET=replace-with-a-long-random-secret
OPENAPI_ENABLED=false
IMPORT_EXPORT_ENABLED=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=calculator
MYSQL_USER=calculator
MYSQL_PASSWORD=calculator
EMAIL_VERIFICATION_ENABLED=false

# Optional OAuth providers (buttons remain unavailable until configured).
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
APPLE_CLIENT_ID=
FACEBOOK_APP_ID=

# Email delivery (verification codes are currently logged in development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
